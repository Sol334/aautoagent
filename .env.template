# ============================================
# GALACTIC CAPITAL — ENVIRONMENT CONFIG
# Financial intelligence + paper-trading system
# ============================================
# Copy this file to .env and replace CHANGE_ME values.
# NEVER commit the .env file.
# Everything defaults to PAPER mode — no real money moves until you flip the gates.
# ============================================

# ---- SHARED INFRA (same Ollama + Telegram as the rest of your stack) ----
OLLAMA_HOST=0.0.0.0:11434
TELEGRAM_BOT_TOKEN=CHANGE_ME
RYAN_TELEGRAM_CHAT_ID=CHANGE_ME
TZ=America/Chicago
LOG_LEVEL=INFO

# ---- MARKET DATA APIS ----
# Finnhub — congressional trades + news headlines (free tier works)
FINNHUB_API_KEY=CHANGE_ME
# Alpaca — equities paper/live broker
ALPACA_API_KEY=CHANGE_ME
ALPACA_SECRET_KEY=CHANGE_ME
# Polygon — options flow (free tier limited; enable FEATURE_OPTIONS_FLOW when confirmed)
POLYGON_API_KEY=CHANGE_ME
# FRED — free macro data (yield curve, CPI). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=CHANGE_ME
# Coinbase Advanced Trade — crypto (enable FEATURE_CRYPTO_TRADING when confirmed)
COINBASE_API_KEY=CHANGE_ME
COINBASE_API_SECRET=CHANGE_ME

# ---- WATCHLIST ----
CAPITAL_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,JPM,GS,XOM,SPY,QQQ

# ---- SAFETY GATES (keep these as-is until you are ready) ----
# Master gate — true = NO real trades ever execute
CAPITAL_PAPER_TRADING=true
FEATURE_OPTIONS_FLOW=false
FEATURE_CRYPTO_TRADING=false
FEATURE_WHEEL_TRADING=false

# ---- POSITION SIZING (designed for a $200 starting stake) ----
CAPITAL_STARTING_USD=200
CAPITAL_MAX_POSITION_USD=20
CAPITAL_MAX_DRAWDOWN_PCT=20

# ---- CONGRESSIONAL-TRADE WATCHDOG THRESHOLDS ----
WATCHDOG_LOOKBACK_DAYS=7
WATCHDOG_HIGH_VALUE_MIN=250000
WATCHDOG_CLUSTER_MIN=2
WATCHDOG_CLUSTER_DAYS=30
WATCHDOG_SIGNAL_MIN_CONF=0.5

# ---- STATE FILE PATHS (default to ./data inside this repo; auto-created) ----
WATCHDOG_STATE_PATH=data/watchdog_state.json
WATCHDOG_LOG_PATH=data/watchdog_log.json
PORTFOLIO_STATE_PATH=data/portfolio_state.json
